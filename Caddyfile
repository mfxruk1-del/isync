# Caddy configuration.
# Caddy automatically gets and renews a FREE HTTPS certificate for your domain.
# The {$DOMAIN} and {$ACME_EMAIL} values are read from your .env file.

{
	# Email used when requesting the free TLS certificate.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Serve the static placeholder site (Phase 0).
	# In Phase 1 this will point at the built PWA instead.
	root * /srv
	file_server

	# Compress responses for faster loading.
	encode gzip zstd

	# Basic security headers.
	header {
		# Tell browsers to always use HTTPS for this site.
		Strict-Transport-Security "max-age=31536000;"
		# Don't let the page be embedded in other sites (clickjacking protection).
		X-Frame-Options "SAMEORIGIN"
		# Don't leak the referrer to other sites.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Remove the default server banner.
		-Server
	}

	# Log requests (handy while we're setting things up).
	log {
		output stdout
		format console
	}
}

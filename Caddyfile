# Caddy configuration.
# Caddy automatically gets and renews a FREE HTTPS certificate for your domain,
# then forwards all traffic to the Vault app container.
# {$DOMAIN} and {$ACME_EMAIL} are read from your .env file.

{
	# Email used when requesting the free TLS certificate.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Compress responses for faster loading.
	encode gzip zstd

	# Allow large uploads (big photos now, big videos later).
	request_body {
		max_size 5GB
	}

	# Send everything to the app container (API + the PWA).
	reverse_proxy app:3000

	# Basic security headers.
	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

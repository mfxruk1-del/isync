# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored on purpose — it holds your private settings.

# Your domain name (the one you own and will point at your VPS).
# Example: photos.mydomain.com   OR   mydomain.com
DOMAIN=yourdomain.com

# An email address — Caddy uses it to register your free HTTPS certificate.
ACME_EMAIL=you@example.com

# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored on purpose — it holds your private settings.

# --- Domain & HTTPS ---
# Your domain name (the one you own and pointed at your VPS).
DOMAIN=yourdomain.com
# An email address — Caddy uses it to register your free HTTPS certificate.
ACME_EMAIL=you@example.com

# --- Your login (the owner account) ---
# These create/update your single account automatically on startup.
OWNER_USERNAME=admin
OWNER_PASSWORD=change-this-to-a-strong-password

# --- Security ---
# A long, random secret used to sign your login cookie.
# Generate one on the VPS with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string
